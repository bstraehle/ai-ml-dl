              "responseTime": "764",
              "body": "{\n  \"id\": \"chatcmpl-f3efd466-beeb-4190-9032-ff1913447956\",\n  \"object\": \"chat.completion\",\n  \"created\": 1792260182,\n  \"model\": \"openai/gpt-oss-120b\",\n  \"choices\": [\n    {\n      \"index\": 0,\n      \"message\": {\n        \"role\": \"assistant\",\n        \"content\": \"A large language model predicts the next token based on statistical patterns it learned from massive text corpora, excelling at fluent generation but without guaranteed logical consistency. A reasoning model, by contrast, is engineered (often on top of an LLM) to perform explicit inference steps, chain‑of‑thought or symbolic manipulation, aiming to produce conclusions that follow from given premises.\",\n        \"reasoning\": \"The user asks: \\\"In two sentences, what is the difference between a large language model and a reasoning model?\\\" So answer succinctly in two sentences. Provide clear distinction. Provide maybe: LLM generates text based on statistical patterns; reasoning model is designed to perform logical inference or chain-of-thought, often built on LLM but with additional mechanisms. Two sentences.\"\n      },\n      \"logprobs\": null,\n      \"finish_reason\": \"stop\"\n    }\n  ],\n  \"usage\": {\n    \"queue_time\": 0.094756777,\n    \"prompt_tokens\": 89,\n    \"prompt_time\": 0.014036904,\n    \"completion_tokens\": 158,\n    \"completion_time\": 0.327057062,\n    \"total_tokens\": 247,\n    \"total_time\": 0.341093966,\n    \"completion_tokens_details\": {\n      \"reasoning_tokens\": 75\n    }\n  },\n  \"usage_breakdown\": null,\n  \"system_fingerprint\": \"fp_90620edd96\",\n  \"x_groq\": {\n    \"id\": \"req_01m55gg4g5ezt9eg86ngjxmz16\",\n    \"seed\": 93534709\n  },\n  \"service_tier\": \"on_demand\"\n}",
