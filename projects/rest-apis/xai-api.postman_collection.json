              "body": "{\n  \"id\": \"ff6535f2-7013-991b-be20-0e352322b918\",\n  \"object\": \"chat.completion\",\n  \"created\": 1792260424,\n  \"model\": \"grok-4.7\",\n  \"choices\": [\n    {\n      \"index\": 0,\n      \"message\": {\n        \"role\": \"assistant\",\n        \"content\": \"A large language model is trained mainly to predict likely next words and produce fluent text from patterns in its training data. A reasoning model is built or tuned to spend extra computation on intermediate steps—such as chain-of-thought or search—before answering, so it handles multi-step problems more reliably than a standard LLM that replies in one pass.\",\n        \"reasoning_content\": \"I need to explain the difference between a large language model and a reasoning model in two sentences.\",\n        \"refusal\": null\n      },\n      \"finish_reason\": \"stop\"\n    }\n  ],\n  \"usage\": {\n    \"prompt_tokens\": 1269,\n    \"completion_tokens\": 70,\n    \"total_tokens\": 1476,\n    \"prompt_tokens_details\": {\n      \"text_tokens\": 1269,\n      \"audio_tokens\": 0,\n      \"image_tokens\": 0,\n      \"cached_tokens\": 1152\n    },\n    \"completion_tokens_details\": {\n      \"reasoning_tokens\": 137,\n      \"audio_tokens\": 0,\n      \"accepted_prediction_tokens\": 0,\n      \"rejected_prediction_tokens\": 0\n    },\n    \"num_sources_used\": 0,\n    \"cost_in_usd_ticks\": 20520000\n  },\n  \"system_fingerprint\": \"fp_c60958d81f66f847\",\n  \"service_tier\": \"default\"\n}",
