              "body": "{\n  \"id\": \"chatcmpl-01a14b08-68d1-736b-b237-f28c142d1dbd\",\n  \"choices\": [\n    {\n      \"finish_reason\": \"stop\",\n      \"index\": 0,\n      \"message\": {\n        \"content\": \"A large language model is trained primarily to predict the next token from vast amounts of text, so it answers quickly and fluently in a single pass. A reasoning model is a large language model additionally trained to spend extra time working through a problem step by step and checking its intermediate thoughts before answering, improving accuracy on math, coding, and logic at the cost of speed.\",\n        \"refusal\": null,\n        \"role\": \"assistant\"\n      },\n      \"logprobs\": null\n    }\n  ],\n  \"created\": 1792260204,\n  \"model\": \"muse-wonder-1.0\",\n  \"object\": \"chat.completion\",\n  \"usage\": {\n    \"completion_tokens\": 712,\n    \"prompt_tokens\": 26,\n    \"total_tokens\": 738,\n    \"completion_tokens_details\": {\n      \"reasoning_tokens\": 629\n    },\n    \"prompt_tokens_details\": {\n      \"cached_tokens\": 0\n    }\n  }\n}",
