              "body": "{\n  \"id\": \"chatcmpl-0488a66754204327abd53b0160eae4a8\",\n  \"object\": \"chat.completion\",\n  \"created\": 1792260359,\n  \"model\": \"reka-edge-2603\",\n  \"choices\": [\n    {\n      \"index\": 0,\n      \"message\": {\n        \"role\": \"assistant\",\n        \"content\": \"A large language model is designed to understand and generate text based on extensive training data, focusing on large-scale capabilities like processing vast amounts of information and context. In contrast, a reasoning model adds cognitive-like reasoning capabilities, enabling it to infer logical conclusions and solve complex problems by analyzing patterns and logic, often requiring real-world reasoning tasks.\\n\\n\",\n        \"refusal\": null,\n        \"annotations\": null,\n        \"audio\": null,\n        \"function_call\": null,\n        \"reasoning_content\": null\n      },\n      \"logprobs\": null,\n      \"finish_reason\": \"stop\",\n      \"stop_reason\": \"<sep>\",\n      \"token_ids\": null\n    }\n  ],\n  \"service_tier\": null,\n  \"system_fingerprint\": null,\n  \"usage\": {\n    \"prompt_tokens\": 23,\n    \"total_tokens\": 90,\n    \"completion_tokens\": 67,\n    \"prompt_tokens_details\": null\n  },\n  \"prompt_logprobs\": null,\n  \"prompt_token_ids\": null,\n  \"kv_transfer_params\": null\n}",
