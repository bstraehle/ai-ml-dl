  "event": [
    {
      "listen": "prerequest",
      "script": {
        "id": "9076f10c-5d03-4730-8eaa-6869a36fbb71",
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "id": "5a54b321-9a34-4c24-b6e4-09b79ac82893",
        "type": "text/javascript",
        "exec": [
          "// GenAI APIs workspace: shared test + visualizer (runs after every request in this collection).",
          "// Shows the model's text reply as formatted Markdown and any returned images/videos inline (Visualize tab).",
          "(function () {",
          "    pm.test(\"Status code is 2xx\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
          "    var body;",
          "    try { body = pm.response.json(); } catch (e) { return; }",
          "    var texts = [], media = [], seen = {};",
          "    function addText(t) { if (typeof t === \"string\" && t.trim()) texts.push(t); }",
          "    function addMedia(url) {",
          "        if (seen[url] || media.length >= 8) return;",
          "        seen[url] = true;",
          "        media.push({ url: url, isVideo: /\\.(mp4|webm|mov)(\\?|$)/i.test(url) || /^data:video\\//i.test(url) });",
          "    }",
          "    (body.choices || []).forEach(function (c) { addText(c && c.message && c.message.content); addText(c && c.text); });",
          "    addText(body.output_text);",
          "    (Array.isArray(body.output) ? body.output : []).forEach(function (o) {",
          "        ((o && o.content) || []).forEach(function (p) { addText(p && p.text); });",
          "    });",
          "    if (Array.isArray(body.content)) body.content.forEach(function (p) { addText(p && p.text); });",
          "    (body.candidates || []).forEach(function (c) {",
          "        (((c && c.content) || {}).parts || []).forEach(function (p) {",
          "            addText(p && p.text);",
          "            if (p && p.inlineData && /^image\\//.test(p.inlineData.mimeType || \"\")) addMedia(\"data:\" + p.inlineData.mimeType + \";base64,\" + p.inlineData.data);",
          "        });",
          "    });",
          "    if (body.message && Array.isArray(body.message.content)) body.message.content.forEach(function (p) { addText(p && p.text); });",
          "    (((body.results || {}).channels) || []).forEach(function (ch) {",
          "        ((ch && ch.alternatives) || []).slice(0, 1).forEach(function (a) { addText(a && a.transcript); });",
          "    });",
          "    if (!texts.length) { addText(body.text); addText(body.response); addText(body.generated_text); }",
          "    if (!texts.length) Object.keys(body).forEach(function (k) {",
          "        var v = body[k];",
          "        if (v && typeof v === \"object\" && typeof v.generated_text === \"string\") addText(\"**\" + k + \"**\\n\\n\" + v.generated_text);",
          "    });",
          "    (Array.isArray(body.data) ? body.data : []).forEach(function (d) { if (d && d.b64_json) addMedia(\"data:image/png;base64,\" + d.b64_json); });",
          "    (function walk(v, depth) {",
          "        if (depth > 6 || media.length >= 8) return;",
          "        if (typeof v === \"string\") {",
          "            if (/^https?:\\/\\/\\S+\\.(png|jpe?g|webp|gif|mp4|webm|mov)(\\?\\S*)?$/i.test(v)) addMedia(v);",
          "        } else if (v && typeof v === \"object\") {",
          "            Object.keys(v).forEach(function (k) { walk(v[k], depth + 1); });",
          "        }",
          "    })(body, 0);",
          "    if (!texts.length && !media.length) return;",
          "    var template = [",
          "        \"<style>body{font-family:system-ui,-apple-system,Segoe UI,sans-serif;font-size:14px;line-height:1.5;margin:12px;color:#222}\",",
          "        \".reply{border:1px solid #e1e4e8;border-radius:8px;padding:4px 14px;margin-bottom:12px;background:#fff}\",",
          "        \"img,video{max-width:100%;border-radius:8px;margin-bottom:12px;display:block}\",",
          "        \"pre{background:#f6f8fa;padding:10px;border-radius:6px;overflow:auto}code{background:#f6f8fa;padding:1px 4px;border-radius:4px}</style>\",",
          "        \"<div id=\\\"out\\\"></div>\",",
          "        \"<script src=\\\"https://cdn.jsdelivr.net/npm/marked@12.0.2/marked.min.js\\\"></script>\",",
          "        \"<script src=\\\"https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js\\\"></script>\",",
          "        \"<script>pm.getData(function (err, data) {\",",
          "        \"  var out = document.getElementById('out');\",",
          "        \"  (data.texts || []).forEach(function (t) {\",",
          "        \"    var d = document.createElement('div'); d.className = 'reply';\",",
          "        \"    if (window.marked && window.DOMPurify) { d.innerHTML = DOMPurify.sanitize(marked.parse(t)); } else { d.style.whiteSpace = 'pre-wrap'; d.textContent = t; }\",",
          "        \"    out.appendChild(d);\",",
          "        \"  });\",",
          "        \"  (data.media || []).forEach(function (m) {\",",
          "        \"    var el = document.createElement(m.isVideo ? 'video' : 'img'); el.src = m.url; if (m.isVideo) { el.controls = true; }\",",
          "        \"    out.appendChild(el);\",",
          "        \"  });\",",
          "        \"});</script>\"",
          "    ].join(\"\\n\");",
          "    pm.visualizer.set(template, { texts: texts, media: media });",
          "})();"
        ]
      }
    }
